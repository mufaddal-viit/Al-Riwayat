# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API. Each entry must be
# a valid absolute URL (scheme + host, no trailing slash). Example for prod:
#   ALLOWED_ORIGIN=https://al-riwayat.vercel.app,http://localhost:3001
ALLOWED_ORIGIN=http://localhost:3001

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ─── Cookie ───────────────────────────────────────────────────────────────────
# Set to your domain in production (e.g. alriwayat.com). Leave blank for localhost.
COOKIE_DOMAIN=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave blank in development — emails will be printed to the console instead.
EMAIL_FROM=noreply@alriwayat.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ─── App ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001

# ─── Data backend ─────────────────────────────────────────────────────────────
# firestore = use Firestore (current, no DB).  prisma = use MongoDB via Prisma.
DATA_BACKEND=firestore

# ─── Firebase Admin ───────────────────────────────────────────────────────────
# From Firebase Console → Project Settings → Service accounts → Generate new private key.
# The downloaded JSON contains project_id, client_email, private_key.
# For FIREBASE_PRIVATE_KEY: paste the whole private key with literal \n for newlines,
# wrapped in double quotes. Example:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# From Cloudinary Console → Dashboard → Product Environment Credentials.
# Used by the submissions module to host user-uploaded images and videos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-to-server secret used by the Next /admin dashboard proxy.
# Must match ADMIN_DASHBOARD_SHARED_SECRET in web/.env.
ADMIN_DASHBOARD_SHARED_SECRET=change-this-to-match-web
