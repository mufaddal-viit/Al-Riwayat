# ─── Site ─────────────────────────────────────────────────────────────────────
# Canonical site URL used for metadataBase, OG images, sitemap, canonical tags.
# Leave blank on Vercel previews — the app falls back to https://$VERCEL_URL.
# Set this explicitly in the Production environment (e.g. https://al-riwayaat.com).
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (optional). Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Analytics / Speed Insights. Keep false unless enabled in Vercel.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false

# ─── Backend API ──────────────────────────────────────────────────────────────
# Leave disabled until the backend URL is live and /api/health returns 200.
# NEXT_PUBLIC_API_URL may be the backend root or include /api; both work.
# Example: https://your-api.up.railway.app
NEXT_PUBLIC_ENABLE_API=false
NEXT_PUBLIC_API_URL=

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Public cloud name only. Never add the Cloudinary API key or API secret here.
# The frontend can display Cloudinary assets; signed uploads happen in /api.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─── Firebase Web SDK ─────────────────────────────────────────────────────────
# From Firebase Console → Project Settings → General → Your apps (Web app) → SDK setup.
# All values are safe to expose in the browser bundle.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
